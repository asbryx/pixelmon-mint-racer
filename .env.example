# Network & Contract Configuration
ROBINHOOD_CHAIN_ID=4663
PIXELMON_CONTRACT_ADDRESS=0x7dE3B4eC32929c7252276bc1b33e4A9FE724180f
PIXELMON_API_BASE_URL=https://pixelmon.mom

# RPC Endpoints (comma-separated or newline-separated)
ROBINHOOD_RPC_URLS=https://robinhood-rpc.publicnode.com,https://rpc.mainnet.chain.robinhood.com,https://rpc.arrowrpc.com

# Wallet & Sweep Configuration
# Path to file containing private keys (one per line, hex format with or without 0x prefix)
PRIVATE_KEY_FILE=/path/to/wallets_private_keys.txt

# Destination wallet where minted NFTs will be swept
SWEEP_DESTINATION_ADDRESS=0x0000000000000000000000000000000000000000

# Gas & Worker Settings
GAS_PRICE_FLOOR_GWEI=2.5
MAX_WORKERS=6
MAX_PAYMENT_WEI=100000000000000
REQUEST_TIMEOUT_SECONDS=20
RECEIPT_TIMEOUT_SECONDS=30
